<Window x:Class="Baymax.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baymax" Height="860" Width="1280"
        MinHeight="700" MinWidth="900"
        Background="#F3F6FB"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#15233B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="EnterButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#115E59"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#115E59"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#134E4A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#134E4A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#64748B"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#64748B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid Margin="0,8">
                <Border x:Name="MessageBubble" HorizontalAlignment="Left"
                        MaxWidth="900" Background="White" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                   Foreground="#172033" FontSize="14"/>
                        <Border x:Name="PlanContent" Visibility="Collapsed"
                                BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="9"
                                Padding="12" Margin="0,12,0,0" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{Binding Plan.Summary}" FontWeight="SemiBold"
                                           FontSize="15" TextWrapping="Wrap" Foreground="#172033"/>
                                <TextBlock Text="{Binding PlanActions.Count, StringFormat={}{0} action(s)}"
                                           Foreground="#64748B" FontSize="12" Margin="0,4,0,8"/>
                                <ItemsControl ItemsSource="{Binding PlanActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E2E8F0"
                                                    BorderThickness="1" CornerRadius="7" Padding="10"
                                                    Margin="0,0,0,7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Heading}" FontWeight="Bold"
                                                               Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                                               Foreground="#334155" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"
                                                               Foreground="#9A3412" FontWeight="SemiBold"
                                                               Margin="0,5,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Warning}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Content}" IsReadOnly="True"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             MaxHeight="180" Margin="0,7,0,0"
                                                             FontFamily="Consolas">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Content}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Result}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         MaxHeight="260" FontFamily="Consolas" Margin="0,4,0,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Edit plan" Click="EditPlanButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlanApproved}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Plan.NeedsClarification}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasPlan}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Discard" Click="DiscardPlanButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlanApproved}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Plan.NeedsClarification}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasPlan}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Approve and run" Background="#2563EB" Foreground="White"
                                            BorderBrush="#2563EB" Click="ApprovePlanButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlanApproved}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Plan.NeedsClarification}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasPlan}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPlan}" Value="True">
                    <Setter TargetName="PlanContent" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="MessageBubble" Property="Background" Value="#DBEAFE"/>
                    <Setter TargetName="MessageBubble" Property="BorderBrush" Value="#BFDBFE"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BAYMAX" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Your local Windows assistant" Foreground="#C5D2E5"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse x:Name="ModelStatusIndicator" Width="9" Height="9" Fill="#F59E0B"
                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModelStatusText" Text="Checking model..."
                                   Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="IdentityText" Foreground="#C5D2E5" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="SettingsButton" Grid.Column="2" Content="Settings"
                        VerticalAlignment="Center" Margin="18,0,0,0"
                        Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E9EEF6" BorderBrush="#D8E0EB"
                    BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <Button x:Name="NewChatButton" DockPanel.Dock="Top" Content="+  New chat" HorizontalContentAlignment="Left"
                            Margin="0,0,0,12" Click="NewChatButton_Click"/>
                    <TextBlock DockPanel.Dock="Top" Text="RECENT CHATS" FontSize="11"
                               FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,8"/>
                    <ListBox x:Name="ChatsListBox"
                             SelectionChanged="ChatsListBox_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9" Margin="0,0,0,5" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding MobileTaskStatus}"
                                                       FontSize="11" Foreground="#0F766E"
                                                       FontWeight="SemiBold" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MobileTaskStatus}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Delete" Padding="6,4"
                                                Margin="6,0,0,0" FontSize="11"
                                                Foreground="#B91C1C" Background="Transparent"
                                                BorderThickness="0" ToolTip="Delete this conversation"
                                                Click="DeleteChatButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChatItemsControl"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  ItemTemplate="{StaticResource ChatMessageTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel MaxWidth="1020" Margin="28,20"
                                            HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" Background="#E8EDF5" BorderBrush="#D8E0EB"
                        BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="WorkspaceText" DockPanel.Dock="Left"
                                       VerticalAlignment="Center" Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusText" Text="Connect to Baymax to begin."
                                       HorizontalAlignment="Right" Foreground="#475569"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PairAndroidButton" Content="Pair Android"
                                    Click="PairAndroidButton_Click"/>
                            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh status"
                                    Click="RefreshButton_Click"/>
                            <Button x:Name="ClearButton" Grid.Column="2" Content="Clear"
                                    Click="ClearButton_Click"/>
                            <Button x:Name="AttachFileButton" Grid.Column="3" Content="Attach file"
                                    Click="AttachFileButton_Click"/>
                            <TextBox x:Name="InstructionTextBox" Grid.Column="4" MinHeight="46"
                                     MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                     Margin="4,0,10,0"
                                     ToolTip="Type @ to find a workspace file. Enter sends; Shift+Enter adds a line."
                                     TextChanged="InstructionTextBox_TextChanged"
                                     PreviewKeyDown="InstructionTextBox_PreviewKeyDown"/>
                            <Button x:Name="EnterButton" Grid.Column="5" Content="Enter"
                                    Style="{StaticResource EnterButtonStyle}"
                                    Click="EnterButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Popup x:Name="FileSuggestionsPopup"
                       PlacementTarget="{Binding ElementName=InstructionTextBox}"
                       Placement="Top" StaysOpen="True">
                    <Border Width="420" MaxHeight="260" Background="White"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="8" Padding="6">
                        <ListBox x:Name="FileSuggestionsListBox" MaxHeight="248"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="FileSuggestionListBox_MouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6">
                                        <TextBlock Text="{Binding RelativePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#1E293B"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>
